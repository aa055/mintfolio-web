# ---------------------------------------------------------------
# End-to-end tests (npm run test:e2e) — copy to .env.e2e
# .env.e2e is gitignored: never commit the service role key.
# The Supabase URL / publishable key / API URL come from .env.
# ---------------------------------------------------------------

# Creates and deletes the throwaway test user. Same value as
# SUPABASE_SERVICE_ROLE_KEY in mintfolio-api/.env.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Optional overrides
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:8000
# Use an already-installed Chromium instead of `npx playwright install chromium`
# PW_CHROMIUM_PATH=
